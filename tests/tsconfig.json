{
	"compilerOptions": {
		"declaration": false,
		"lib": [
			"ES2024"
		],
		"module": "Node16",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"removeComments": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2024",
		"types": [
			"jest",
			"node",
			"vscode"
		],
		"moduleResolution": "Node16",
		"noEmitOnError": true,
		"isolatedModules": true
	}
}
