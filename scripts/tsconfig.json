{
	"compilerOptions": {
		"target": "ES2024",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2024"
		],
		"types": [
			"bun"
		],
		"strict": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"skipLibCheck": true
	},
	"include": [
		"*.ts"
	]
}
