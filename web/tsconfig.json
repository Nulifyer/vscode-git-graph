{
	"compilerOptions": {
		"lib": [
			"ES2024",
			"DOM"
		],
		"module": "Node16",
		"moduleResolution": "Node16",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"outDir": "../.build/web",
		"removeComments": true,
		"strict": true,
		"target": "ES2024",
		"rootDir": "..",
		"types": [],
		"noEmitOnError": true,
		"moduleDetection": "legacy"
	}
}
